function onLoad()
  updateGmNotes()
end

function onDrop()
  updateGmNotes()
end

function updateGmNotes()
  local count = 0
  local objs  = getObjectsWithTag("ScenarioReference")
  if #objs > 0 then
    count = tonumber(objs[1].getVar("val")) or 0
  end

  local notes = self.getGMNotes()
  local updatedNotes, replacements = notes:gsub(
    '\"count\": %d+,',
    '\"count\": ' .. count .. ',',
    1
  )
  if replacements > 0 then
    self.setGMNotes(updatedNotes)
  end
end
