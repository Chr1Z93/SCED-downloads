---------------------------------------------------------
-- XML click functions
---------------------------------------------------------

-- draws a card to the playermat of the requesting player
function drawCard(player)
  local deck = getDeck("DRAW")
  if not deck then
    if getDeck("DISCARD") then
      player.showConfirmDialog("Reshuffle discard and draw?", function()
        reshuffle(nil, nil, nil, player)
      end)
    end
    return
  end

  local matColor = PlayermatApi.getMatColor(player.color)
  local pos      = PlayermatApi.getEncounterCardDrawPosition(matColor, false)
  local rot      = PlayermatApi.returnRotation(matColor)
  local card     = deck
  if deck.type == "Deck" then
    card = deck.takeObject({ position = deck.getPosition() + Vector(0, 1, 0) })
  end
  card.addTag("DeckHelperDrawn")
  addReturnMenu(card)
  DeckLib.placeOrMergeIntoDeck(card, Vector(pos), rot)

  local pName = GlobalApi.getColoredName(player.color)
  printToAll(pName .. " drew a card from the " .. DECK_NAME .. ".")
end

function discardTopCard()
  local deck = getDeck("DRAW")
  if not deck then return end

  local pos  = self.positionToWorld(CAST_POS.DISCARD)
  local rot  = self.getRotation()
  local card = deck
  if deck.type == "Deck" then
    card = deck.takeObject({ position = deck.getPosition() + Vector(0, 1, 0) })
  end
  card.addTag("DeckHelperDrawn")
  addReturnMenu(card)
  DeckLib.placeOrMergeIntoDeck(card, Vector(pos), rot)
end

function reshuffle(_, _, _, playerToDrawAfter)
  -- flag to avoid multiple calls
  if isReshuffling then return false end
  isReshuffling = true

  -- disable flag after 1s delay
  Wait.time(function() isReshuffling = false end, 1)

  local discardDeck = getDeck("DISCARD")
  if discardDeck then
    local faceDownRotation = self.getRotation():setAt("z", 180)
    local newPos           = self.positionToWorld(CAST_POS.DRAW)
    DeckLib.placeOrMergeIntoDeck(discardDeck, newPos, faceDownRotation, nil, true)

    broadcastToAll(DECK_NAME .. ": Shuffled discard pile into deck.", "White")
    if playerToDrawAfter then
      drawCard(playerToDrawAfter)
    end
  else
    broadcastToAll(DECK_NAME .. ": Discard pile is already empty.", "Red")
  end
end

-- toggles the help text for the player that clicks it
function toggleHelp(player)
  if helpViewers[player.color] then
    helpViewers[player.color] = nil
  else
    helpViewers[player.color] = true
  end
  updateHelpVisibility()
end

---------------------------------------------------------
-- helper functions
---------------------------------------------------------

-- returns the first object found, type can be "deck" or "discard"
function getDeck(type)
  local result = SearchLib.atPosition(self.positionToWorld(CAST_POS[type]), "isCardOrDeck")
  if #result > 0 then
    return result[1]
  end
  return nil
end

-- updates the visibility of the help text
function updateHelpVisibility()
  local visibility = ""
  for playerColor, _ in pairs(helpViewers) do
    if string.len(visibility) > 0 then
      visibility = visibility .. "|" .. playerColor
    else
      visibility = playerColor
    end
  end
  self.UI.setAttribute("helpText", "visibility", visibility)
  self.UI.setAttribute("helpPanel", "visibility", visibility)
  self.UI.setAttribute("helpPanel", "active", string.len(visibility) > 0)
end
