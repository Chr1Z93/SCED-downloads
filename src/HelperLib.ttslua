do
  local HelperLib       = {}

  local DeckLib         = require("util/DeckLib")
  local MythosAreaApi   = require("mythos/MythosAreaApi")
  local PlayAreaApi     = require("playarea/PlayAreaApi")
  local PlayermatApi    = require("playermat/PlayermatApi")
  local SearchLib       = require("util/SearchLib")
  local TableLib        = require("util/TableLib")

  local OFFSET_X        = 2
  local OFFSET_Z        = 2
  local MINI_OFFSET     = {
    Vector(OFFSET_X, 0, OFFSET_Z),
    Vector(-OFFSET_X, 0, OFFSET_Z),
    Vector(-OFFSET_X, 0, -OFFSET_Z),
    Vector(OFFSET_X, 0, -OFFSET_Z),
  }
  local VALID_MATCOLORS = {
    White  = true,
    Orange = true,
    Green  = true,
    Red    = true
  }

  -- Checks if a card has clues on it
  ---@param card tts__Object Card to check for clues
  ---@return boolean hasClues True if card has clues on it
  function HelperLib.cardHasClues(card)
    return #SearchLib.onObject(card, "isClue") > 0
  end

  function HelperLib.getMetadata(objectOrNotes)
    if objectOrNotes == nil then return {} end
    local rawNotes
    if type(objectOrNotes) == "string" then
      rawNotes = objectOrNotes
    elseif type(objectOrNotes) == "table" then
      rawNotes = objectOrNotes["GMNotes"] or objectOrNotes["gm_notes"]
    else
      rawNotes = objectOrNotes.getGMNotes()
    end
    if rawNotes == nil or rawNotes == "" then return {} end
    return JSON.decode(rawNotes) or {}
  end

  -- Simple method to check if the given point is in a specified area
  ---@param point tts__Vector Point to check, only x and z values are relevant
  ---@param bounds table Defined area to see if the point is within
  function HelperLib.isInArea(point, bounds)
    return (point.x > bounds.minX
      and point.x < bounds.maxX
      and point.z > bounds.minZ
      and point.z < bounds.maxZ)
  end

  ---@param container tts__Object Container to check
  ---@param guid string GUID to search for
  ---@return boolean: Whether there is an object with this GUID in the container
  function HelperLib.checkContainerForGuid(container, guid)
    if container ~= nil and container.getData().ContainedObjects then
      for _, info in ipairs(container.getObjects()) do
        if info.guid == guid then
          return true
        end
      end
    end
    return false
  end

  function HelperLib.moveInvestigatorMinis(grid, name)
    local shouldMove = {}
    for _, matColor in ipairs(PlayermatApi.getUsedMatColors()) do
      local miniId = PlayermatApi.getActiveInvestigatorData(matColor).miniId
      shouldMove[miniId] = true
    end

    local movedMiniCount = 0
    local basePos        = PlayAreaApi.gridToWorld(grid)
    for _, minicard in ipairs(getObjectsWithTag("MiniCard")) do
      local md = JSON.decode(minicard.getGMNotes())
      if md and md.id and shouldMove[md.id] then
        movedMiniCount = movedMiniCount + 1
        minicard.setPosition(basePos + MINI_OFFSET[movedMiniCount])
        shouldMove[md.id] = nil
      end
    end

    if movedMiniCount > 0 and name then
      broadcastToAll(string.format(
        "Moved %d mini card%s to %s.",
        movedMiniCount,
        movedMiniCount == 1 and "" or "s",
        name
      ))
    end
  end

  function HelperLib.spawnMythosDeckOrCard(objects, name, shuffle)
    if #objects == 0 then return end

    local position
    local rotation = MythosAreaApi.getRotation()
    if name == "Act Deck" then
      position = MythosAreaApi.getActPosition()
      rotation = rotation - Vector(0, 90, 0)
    elseif name == "Agenda Deck" then
      position = MythosAreaApi.getAgendaPosition()
      rotation = rotation - Vector(0, 90, 0)
    elseif name == "Encounter Deck" then
      position = MythosAreaApi.getEncounterDeckPosition()
      rotation = rotation + Vector(0, 0, 180)
    else
      printToAll("Unhandled name for 'spawnMythosDeckOrCard()'!")
      return
    end

    if shuffle then
      TableLib.shuffle(objects)
    elseif name == "Act Deck" or name == "Agenda Deck" then
      table.sort(objects, function(a, b) return a.Description > b.Description end)
    end

    if #objects == 1 then
      return DeckLib.spawnCard(objects[1], position, rotation)
    else
      local deckdata = DeckLib.generateDeckData(objects, position, rotation)
      deckdata.Nickname = name
      if name == "Encounter Deck" then
        deckdata.HideWhenFaceDown = true
      end
      return spawnObjectData({ data = deckdata })
    end
  end

  -- Sorts an object list by configured nickname, metadata ID, or metadata type.
  -- Higher priority values are sorted first; unmatched objects use priority 500.
  ---@param objects table Set-aside object data
  ---@param priority? table Optional priority map
  function HelperLib.sortObjectList(objects, priority)
    priority = priority or {}

    local function getPriority(object)
      local metadata = HelperLib.getMetadata(object)
      return priority[object.Nickname]
          or priority[metadata.id]
          or priority[metadata.type]
          or 500
    end

    table.sort(objects, function(a, b)
      return getPriority(a) > getPriority(b)
    end)
  end

  -- Combines objects with matching names, fields, or extractor results into decks.
  ---@param objects table Object data to combine
  ---@param criteria? string|function an object/metadata field, or a key extractor
  ---@return table: Combined object data in first-match order
  function HelperLib.combineObjects(objects, criteria)
    if criteria == nil or type(criteria) ~= "string" and type(criteria) ~= "function" then
      error("combineObjects criteria must be a string or function")
    end

    local groups      = {}
    local keysByIndex = {}
    for index, object in ipairs(objects) do
      local metadata = HelperLib.getMetadata(object)
      local key
      if type(criteria) == "function" then
        key = criteria(object, metadata)
      else
        key = object[criteria] or metadata[criteria]
      end

      if key ~= nil then
        keysByIndex[index] = key
        groups[key]        = groups[key] or {}
        table.insert(groups[key], object)
      end
    end

    local combined  = {}
    local processed = {}
    for index, object in ipairs(objects) do
      local key   = keysByIndex[index]
      local group = key ~= nil and groups[key] or nil
      if group == nil or #group == 1 then
        table.insert(combined, object)
      elseif not processed[key] then
        local cardList = {}
        for _, groupObject in ipairs(group) do
          if type(groupObject.ContainedObjects) == "table" then
            for _, cardData in ipairs(groupObject.ContainedObjects) do
              table.insert(cardList, cardData)
            end
          else
            table.insert(cardList, groupObject)
          end
        end

        if #cardList > 1 then
          local deckData    = DeckLib.generateDeckData(cardList)
          deckData.Nickname = tostring(key)
          processed[key]    = true
          table.insert(combined, deckData)
        else
          for _, groupObject in ipairs(group) do
            table.insert(combined, groupObject)
          end
          processed[key] = true
        end
      end
    end

    return combined
  end

  function HelperLib.getMatColorFromMemo(card)
    local memo = card.getMemo()
    return VALID_MATCOLORS[memo] and memo or nil
  end

  return HelperLib
end
